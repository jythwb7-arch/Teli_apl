    public static void installAll(int currentAccount) {
        for (String packName : EMOJI_PACKS) {
            TLRPC.TL_messages_getStickerSet req = new TLRPC.TL_messages_getStickerSet();
            req.stickerset = new TLRPC.TL_inputStickerSetShortName();
            req.stickerset.short_name = packName;
            
            ConnectionsManager.getInstance(currentAccount).sendRequest(req, (response, error) -> {
                if (response instanceof TLRPC.TL_messages_stickerSet) {
                    TLRPC.TL_messages_stickerSet set = (TLRPC.TL_messages_stickerSet) response;
                    MediaDataController.getInstance(currentAccount)
                        .toggleStickerSet(null, set.set, 0, false, false, false);
                }
            });
        }
    }
